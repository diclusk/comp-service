+-- Migration: user login (Supabase Auth) + anonymous guest booking session
+-- Jalankan manual di Supabase Dashboard > SQL Editor (project "computer-service")
+
+-- 1. Link tabel customers ke akun Supabase Auth (nullable — customer anon gak punya ini)
+alter table customers
+  add column if not exists user_id uuid references auth.users(id);
+
+-- 2. Identitas booking anonymous (sessionStorage di client, nullable — booking dari user
+--    yang login gak butuh ini karena sudah ke-link lewat customers.user_id)
+alter table bookings
+  add column if not exists guest_session_id uuid;
